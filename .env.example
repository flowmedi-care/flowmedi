# URL base do app (obrigatório para links em emails)
NEXT_PUBLIC_APP_URL=https://flowmedi.com.br

# Supabase (SERVICE_ROLE é necessário para o webhook WhatsApp gravar mensagens recebidas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Token HMAC para links de PDF (recibos/orçamentos) enviados a pacientes via /api/files/{token}
FILE_ACCESS_TOKEN_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Google OAuth — integração Gmail (envio de e-mails pela clínica)
# Cadastre no Google Cloud Console (Credenciais > OAuth 2.0 > URIs de redirecionamento):
#   {NEXT_PUBLIC_APP_URL}/api/integrations/google/callback
# Ex.: https://flowmedi.com.br/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google OAuth — login de usuário (Supabase Auth, NÃO usa estas env vars no código)
# 1. Supabase Dashboard → Authentication → Providers → Google: ativar e colar Client ID/Secret
# 2. Google Cloud Console → URIs de redirecionamento autorizados (adicional ao Gmail):
#      https://<PROJECT_REF>.supabase.co/auth/v1/callback
# 3. Supabase Dashboard → Authentication → URL Configuration:
#      Site URL: {NEXT_PUBLIC_APP_URL}
#      Redirect URLs: http://localhost:3000/auth/callback
#                     {NEXT_PUBLIC_APP_URL}/auth/callback

# Meta/WhatsApp (Cadastro Incorporado)
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_SYSTEM_USER_TOKEN=
# Webhook WhatsApp: use https://seu-dominio.com/api/integrations/whatsapp/webhook no app Meta
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WhatsApp Flow — confirmação 2d (Sim/Não/Remarcar). Ver docs/WHATSAPP-FLOW-CONFIRMACAO.md
META_WHATSAPP_CONFIRMATION_FLOW_ID=
META_WHATSAPP_CONFIRMATION_FLOW_TEMPLATE=flowmedi_confirmacao_flow
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# API de transcrição de áudio (somente backend — nunca expor no frontend)
TRANSCRIBE_API_URL=https://transcribe.viaprove.com.br
TRANSCRIBE_API_KEY=
TRANSCRIBE_POLL_INTERVAL_MS=3000
TRANSCRIBE_TIMEOUT_RECORDING_MS=2700000
TRANSCRIBE_TIMEOUT_WPP_MS=300000

# OpenAI — assistente virtual WhatsApp
OPENAI_API_KEY=

# Cron jobs (rodar na VPS — NÃO usar Vercel Cron para o assistente)
# A mesma chave deve existir na VPS e nas env vars do Vercel (validação do endpoint).
CRON_SECRET=
# Exemplo crontab na VPS (a cada 2 min, rede de segurança do assistente):
# */2 * * * * curl -fsS "https://www.flowmedi.com.br/api/cron/process-whatsapp-ai?secret=SEU_CRON_SECRET"
# Compliance / formulários (já existente):
# */15 * * * * curl -fsS -H "Authorization: Bearer SEU_CRON_SECRET" "https://www.flowmedi.com.br/api/cron/check-compliance"

# --- Painel de Validação de APIs ---
# Ativar só durante auditoria; depois remova a variável ou defina false e redeploy na Vercel.
# ENABLE_API_AUDIT_PANEL=true
# ENABLE_API_AUDIT_PANEL=false
#
# Contas dedicadas de teste (criar no Supabase Auth + profiles com role correto).
# Adicionar na Vercel → Settings → Environment Variables (Production/Preview) e redeploy.
#
# Fixtures: use IDs reais do ambiente de staging (não deixe "demo" se a clínica não existir).
# API_AUDIT_CLINIC_SLUG=slug-da-clinica-staging
# API_AUDIT_CONTACT_SLUG=slug-da-clinica-staging
# API_AUDIT_PLAN_ID=uuid-de-plano-existente
# API_AUDIT_CONVERSATION_ID=uuid-de-conversa-whatsapp-da-clinica
# API_AUDIT_SUGGESTION_ID=uuid-de-sugestao-publica-existente
# API_AUDIT_APPOINTMENT_ID=
# API_AUDIT_TRANSCRIPTION_ID=
# API_AUDIT_FORM_INSTANCE_ID=
# API_AUDIT_SUGGESTION_TOKEN=
# API_AUDIT_CRON_SECRET=
# API_AUDIT_META_VERIFY_TOKEN=
# API_AUDIT_ADMIN_EMAIL=
# API_AUDIT_ADMIN_PASSWORD=
# API_AUDIT_SECRETARIA_EMAIL=
# API_AUDIT_SECRETARIA_PASSWORD=
