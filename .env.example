# URL base do app (obrigatório para links em emails)
NEXT_PUBLIC_APP_URL=https://flowmedi.com.br

# Supabase (SERVICE_ROLE é necessário para o webhook WhatsApp gravar mensagens recebidas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Google OAuth (email)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta/WhatsApp (Cadastro Incorporado)
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_SYSTEM_USER_TOKEN=
# Webhook WhatsApp: use https://seu-dominio.com/api/integrations/whatsapp/webhook no app Meta
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# API de transcrição de áudio (somente backend — nunca expor no frontend)
TRANSCRIBE_API_URL=https://transcribe.viaprove.com.br
TRANSCRIBE_API_KEY=
TRANSCRIBE_POLL_INTERVAL_MS=3000
TRANSCRIBE_TIMEOUT_RECORDING_MS=2700000
TRANSCRIBE_TIMEOUT_WPP_MS=300000

# OpenAI — assistente virtual WhatsApp
OPENAI_API_KEY=

# Cron jobs (rodar na VPS — NÃO usar Vercel Cron para o assistente)
# A mesma chave deve existir na VPS e nas env vars do Vercel (validação do endpoint).
CRON_SECRET=
# Exemplo crontab na VPS (a cada 2 min, rede de segurança do assistente):
# */2 * * * * curl -fsS "https://www.flowmedi.com.br/api/cron/process-whatsapp-ai?secret=SEU_CRON_SECRET"
# Compliance / formulários (já existente):
# */15 * * * * curl -fsS -H "Authorization: Bearer SEU_CRON_SECRET" "https://www.flowmedi.com.br/api/cron/check-compliance"

